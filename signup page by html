<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login / Sign Up</title>
  <link rel="stylesheet" href="atr.css">
</head>
<body>

<div class="auth-card" id="authCard">
  <div class="form-container sign-in-container">
    <form action="#">
      <h1>Sign In</h1>
      <p class="subtitle">Access your account</p>
      
      <div class="form-group">
        <input type="email" placeholder="Email" required>
      </div>
      <div class="form-group">
        <input type="password" placeholder="Password" required>
      </div>
      
      <button type="submit" class="btn">Sign In</button>
      <a href="#" class="forgot-link">Forgot password?</a>
    </form>
  </div>
  <div class="form-container sign-up-container">
    <form action="#">
      <h1>Create Account</h1>
      <p class="subtitle">Enter details to register</p>
      
      <div class="form-group">
        <input type="text" placeholder="Name" required>
      </div>
      <div class="form-group">
        <input type="email" placeholder="Email" required>
      </div>
      <div class="form-group">
        <input type="password" placeholder="Password" required>
      </div>
      
      <button type="submit" class="btn">Sign Up</button>
    </form>
  </div>
  <div class="overlay-container">
    <h2 id="overlayTitle">Hello, Friend!</h2>
    <p id="overlaySub">Enter your personal details to get started</p>
    <button class="btn btn-outline" id="toggleBtn">Sign Up</button>
  </div>

</div>

<script>
  const authCard = document.getElementById('authCard');
  const toggleBtn = document.getElementById('toggleBtn');
  const overlayTitle = document.getElementById('overlayTitle');
  const overlaySub = document.getElementById('overlaySub');

  toggleBtn.addEventListener('click', () => {
    const isSignUp = authCard.classList.toggle('right-panel-active');

    if (isSignUp) {
      overlayTitle.textContent = 'Welcome Back!';
      overlaySub.textContent = 'To keep connected, please log in with your info';
      toggleBtn.textContent = 'Sign In';
    } else {
      overlayTitle.textContent = 'Hello, Friend!';
      overlaySub.textContent = 'Enter your personal details to get started';
      toggleBtn.textContent = 'Sign Up';
    }
  });
</script>

</body>
</html>
