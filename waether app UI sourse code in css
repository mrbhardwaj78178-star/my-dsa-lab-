:root {
 
  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  
  
  --bg-gradient: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
  --glass-surface: rgba(255, 255, 255, 0.08);
  --glass-surface-hover: rgba(255, 255, 255, 0.16);
  --glass-border: rgba(255, 255, 255, 0.15);
  --glass-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.35);
  
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.7);
  
 
  --radius-card: 24px;
  --radius-pill: 12px;
  --transition-fast: 0.2s ease;
}


*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-sans);
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  background: var(--bg-gradient);
  color: var(--text-primary);
  padding: 1.25rem;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}


.dashboard {
  width: 100%;
  display: flex;
  justify-content: center;
}

.weather-card {
  width: 100%;
  max-width: 380px; 
  background: var(--glass-surface);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-card);
  padding: 1.75rem;
  box-shadow: var(--glass-shadow);
}

  text-align: center;
  margin-bottom: 1.5rem;
}

.location {
  font-size: 1.25rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.date {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 0.15rem;
}

.current-weather {
  text-align: center;
  margin-bottom: 2rem;
}

.temp-group {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
}

.weather-icon {
  width: 52px;
  height: 52px;
  stroke: var(--text-primary);
  stroke-width: 1.75;
}

.temperature {
  font-size: 4rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
}

.temperature .unit {
  font-size: 1.75rem;
  font-weight: 300;
  vertical-align: super;
}

.condition {
  margin-top: 0.5rem;
  font-size: 0.95rem;
  color: var(--text-secondary);
}
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.metric {
  background: var(--glass-surface);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-pill);
  padding: 0.85rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.metric dt {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.metric dt svg {
  width: 14px;
  height: 14px;
}

.metric dd {
  font-size: 1.1rem;
  font-weight: 600;
}
.forecast-section h2 {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-secondary);
  margin-bottom: 0.75rem;
}

.forecast-list {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.5rem;
}

.forecast-day {
  background: var(--glass-surface);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-pill);
  padding: 0.75rem 0.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  transition: background var(--transition-fast), transform var(--transition-fast);
}

.forecast-day:hover {
  background: var(--glass-surface-hover);
  transform: translateY(-2px);
}

.day-name {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.forecast-day svg {
  width: 20px;
  height: 20px;
}

.high-temp {
  font-size: 0.85rem;
  font-weight: 600;
}
@media (max-width: 360px) {
  .metrics-grid {
    grid-template-columns: 1fr; /* Single column on tiny screens */
  }
}
